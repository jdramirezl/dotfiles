#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
paths=("$@")
if (( ${#paths[@]} == 0 )); then
  paths=("$ROOT/config" "$ROOT/Brewfile" "$ROOT/README.md" "$ROOT/docs" "$ROOT/agent-sops")
fi

failed=0
report() {
  printf 'BLOCKED: %s\n' "$1" >&2
  failed=1
}

for path in "${paths[@]}"; do
  [[ -e "$path" || -L "$path" ]] || continue
  while IFS= read -r nested; do
    report "nested Git metadata: $nested"
  done < <(find "$path" -name .git -print 2>/dev/null)

  while IFS= read -r sensitive; do
    report "sensitive filename: $sensitive"
  done < <(find "$path" -type f \( -name 'id_rsa*' -o -name 'id_ecdsa*' -o -name '*.pem' -o -name '*.key' -o -name '.netrc' -o -name 'credentials' \) -print 2>/dev/null)

done

patterns=(
  'BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY'
  'AKIA[0-9A-Z]{16}'
  '(password|passwd|token|secret|api[_-]?key)[[:space:]]*=[[:space:]]*["'"'][^"'"']{8,}["'"']'
  '(/Users/[^/[:space:]]+)'
  '(corp\.amazon\.com|aka\.corp\.amazon\.com)'
)

for pattern in "${patterns[@]}"; do
  matches="$(grep -ERIl --exclude-dir=.git -- "$pattern" "${paths[@]}" 2>/dev/null || true)"
  if [[ -n "$matches" ]]; then
    while IFS= read -r match; do
      [[ -n "$match" ]] && report "sensitive content pattern in $match"
    done <<< "$matches"
  fi
done

if (( failed != 0 )); then
  printf 'Secret/privacy check failed. Values were intentionally not printed.\n' >&2
  exit 1
fi
printf 'Secret/privacy check passed.\n'
